  "scripts": {
    "dev": "next dev --webpack --inspect",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:push:local": "supabase db push --local",
    "db:reset:local": "supabase db reset",
    "db:push:staging": "bash -c 'source .env.local && supabase db push --db-url \"$SUPABASE_DB_URL_STAGING\" --yes'",
    "db:push:prod": "bash -c 'source .env.local && supabase db push --db-url \"$SUPABASE_DB_URL_PROD\" --yes'",
    "db:pull:staging": "bash -c 'source .env.local && supabase db pull --db-url \"$SUPABASE_DB_URL_STAGING\"'",
    "db:dump:staging": "bash -c 'source .env.local && supabase db dump --db-url \"$SUPABASE_DB_URL_STAGING\" -f remote_schema_staging.sql'",
    "db:dump:prod": "bash -c 'source .env.local && supabase db dump --db-url \"$SUPABASE_DB_URL_PROD\" -f remote_schema_prod.sql'",
    "db:diff": "supabase db diff --use-migra"
  },
